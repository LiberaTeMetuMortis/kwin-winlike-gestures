    OBS source services. Runs when GitHub Actions triggers OBS after a v* tag
    passes CI (see .github/workflows/build.yml):
      obs_scm      checks out main from GitHub, takes the version from the
                   newest v* tag, and extracts the spec, .changes and
                   rpmlintrc from the repo (release.sh writes the .changes entry)
      tar, recompress, set_version   (at build time) turn the checkout into
                   kwin-winlike-gestures-<version>.tar.gz and write the
                   version into the spec
-->
<services>
  <service name="obs_scm">
    <param name="url">https://github.com/LiberaTeMetuMortis/kwin-winlike-gestures.git</param>
    <param name="scm">git</param>
    <param name="revision">main</param>
    <param name="filename">kwin-winlike-gestures</param>
    <param name="match-tag">v*</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <!-- spec, .changes and rpmlintrc (a glob, so new packaging files need no edit here) -->
    <param name="extract">packaging/kwin-winlike-gestures*</param>
  </service>
  <service name="tar" mode="buildtime"/>
  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service name="set_version" mode="buildtime"/>
</services>
